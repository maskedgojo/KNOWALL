# Create this database/user in your local PostgreSQL installation first.
# Copy this file to .env and replace the placeholder password.
DATABASE_URL=your database url(postgresql://user:password@localhost/dbname)
SECRET_KEY=generate the key using the command below and replace it here
# To generate a strong secret, run:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECURE=false
KNOWALL_SEED_ADMIN_PASSWORD=strongadminpassword
KNOWALL_SEED_RESIDENT_PASSWORD=strongadminpassword12
KNOWALL_SEED_COORDINATOR_PASSWORD=strongcoordinatorpassword

# Frontend
FRONTEND_BASE_URL=http://localhost:3000

# Enable real email delivery
MAIL_DELIVERY_MODE=smtp

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls

SMTP_USERNAME=your mail 
SMTP_PASSWORD=your app password
MAIL_FROM=your mail

SURYA_INFERENCE_BACKEND=llamacpp
SURYA_INFERENCE_KEEP_ALIVE=1
SURYA_INFERENCE_PARALLEL=1
LLAMA_CPP_BINARY=C:/tools/llama.cpp/llama-server.exe

#to run :  python -m flask --app app:create_app run --debug --port 5000